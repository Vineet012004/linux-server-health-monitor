*.py[cod]
*$py.class
*.pyo
*.pyc

# pytest and coverage caches
.pytest_cache/
.coverage
htmlcov/
.tox/

# Generated reports (keep the placeholder so the directory is tracked)
reports/*.json

# Distribution / packaging artifacts
dist/
build/
*.egg-info/
*.egg

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Logs
*.log

# Environment variable files (may contain secrets)
.env
*.env
